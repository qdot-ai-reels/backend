FROM node:22-bookworm-slim

WORKDIR /workspace

# HyperFrames renders through headless Chromium and uses FFmpeg for media output.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    ffmpeg \
    ca-certificates \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global hyperframes@0.8.12

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    HYPERFRAMES_WORKSPACE=/workspace

ENTRYPOINT ["hyperframes"]
