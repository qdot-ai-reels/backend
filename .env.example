# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db:5432/app_db

# AWS S3 Settings
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenRouter AI Settings
# Separate credentials by task. Do not reuse the script/TTS keys for video generation.
OPENROUTER_SCRIPT_API_KEY=
OPENROUTER_TTS_API_KEY=
OPENROUTER_VIDEO_API_KEY=
OPENROUTER_SCRIPT_MODEL=
OPENROUTER_MODEL=
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=
OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite
OPENROUTER_VIDEO_API_URL=https://openrouter.ai/api/v1/videos
OPENROUTER_VIDEO_SUPPORTED_DURATIONS=4,6,8

# CORS Settings
CORS_ORIGINS=http://localhost:3000

# Global settings encryption (generate once with Fernet.generate_key())
SETTINGS_ENCRYPTION_KEY=
